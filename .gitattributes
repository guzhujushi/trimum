# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts should always use LF
*.sh text eol=lf

# Lua files (Hyprland config) should use LF
*.lua text eol=lf

# Python files
*.py text eol=lf

# YAML / TOML
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf

# Markdown / docs
*.md text eol=lf
*.txt text eol=lf

# Config files
*.json text eol=lf
*.ini text eol=lf
*.conf text eol=lf

# PowerShell scripts
*.ps1 text eol=crlf
*.psm1 text eol=crlf

# Binary (images, etc)
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.rgb binary
